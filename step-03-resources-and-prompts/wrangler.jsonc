{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-mcp-step-03",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  // agents/mcp/server uses AsyncLocalStorage, which Workers only exposes under nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Step 3's own namespace, titled NOTES_STEP03 on Cloudflare (titles are
  // account-wide and step 2 already used "NOTES"), but bound here as NOTES
  // to match what src/notes.ts reads from env - the binding name is what
  // matters in code, not the namespace's title.
  "kv_namespaces": [{ "binding": "NOTES", "id": "b8c25cb2af77414c97ae6f1e43aeba2e" }]
}
