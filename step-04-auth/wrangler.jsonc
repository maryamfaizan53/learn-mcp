{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-mcp-step-04",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  // agents/mcp/server uses AsyncLocalStorage, which Workers only exposes under nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Step 4 gets its own namespace, separate from earlier steps, so testing
  // here never touches data from a step that's already been graded. Titles
  // are account-wide on Cloudflare, so use a step-specific title (e.g.
  // NOTES_STEP04) when running `npx wrangler kv namespace create`, but keep
  // the binding itself NOTES to match what src/notes.ts reads from env.
  "kv_namespaces": [{ "binding": "NOTES", "id": "5692b208d380488aa1c20e36c028c764" }],
  // Better Auth's own data (users, sessions, OAuth clients) - never the notes
  // themselves, which stay in KV. Run `npx wrangler d1 create learn-mcp-step-04-auth`
  // on a machine logged in to your own Cloudflare account, then replace the
  // database_id below with the one it prints. `wrangler dev` (local, no
  // --remote) works fine with this placeholder; `wrangler deploy` needs the
  // real id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-mcp-step-04-auth",
      "database_id": "6a254ac6-9677-439b-afec-0d4afcd2bcb8"
    }
  ],
  // The exact URL this Worker is reachable at - tokens are bound to
  // `${MCP_BASE_URL}/mcp` (RFC 8707), so this must match precisely. Update
  // it to the real https://learn-mcp-step-04.<subdomain>.workers.dev before
  // deploying; localhost is only correct for `wrangler dev`.
  "vars": {
    "MCP_BASE_URL": "https://learn-mcp-step-04.maryamfaizan-mcp.workers.dev"
  },
  // @modelcontextprotocol/server imports zod via the "zod/v4" subpath,
  // while better-auth's packages import plain "zod" - both resolve to the
  // same underlying file, but as two different wrapper modules, which
  // esbuild bundles as two separate copies of zod's internals. That's the
  // confirmed cause of a "ZodLazy is not a constructor" crash at Worker
  // startup (reproduced by isolating the Better Auth plugin stack alone,
  // which builds fine - the crash only appears once @modelcontextprotocol/
  // server's "zod/v4" import is in the same bundle too). Aliasing collapses
  // both specifiers onto the exact same module.
  "alias": { "zod/v4": "zod" }
}
